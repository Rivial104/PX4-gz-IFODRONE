<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="ifodrone">

    <!-- START 1 METR NAD ZIEMIĄ -->
    <pose>0 0 1 0 0 0</pose>

    <!-- ================= KADŁUB ================= -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.34</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.34</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- LEG BACK RIGHT -->
      <collision name="leg_back_right_collision">
        <pose>-0.3 -0.3 -0.20 -0.7854 0 -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.34</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_back_right_visual">
        <pose>-0.3 -0.3 -0.20 -0.7854 0 -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.34</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- LEG BACK LEFT -->
      <collision name="leg_back_left_collision">
        <pose> -0.3 0.3 -0.20  0.7854 0  -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.34</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="leg_back_left_visual">
        <pose>-0.3 -0.3 -0.20 -0.7854 0 -0.7854</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.34</length>
          </cylinder>
        </geometry>
      </visual>

<!-- ================= SENSORY ================= -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- ================= ROTOR 0 – GÓRA (CZERWONY) ================= -->
    <link name="rotor_0">
      <pose>0 0 0.1 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="motor">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
        <material><diffuse>1 0 0 1</diffuse></material>
      </visual>

      <visual name="prop_0">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.02 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ================= ROTOR 1 – DÓŁ (ZIELONY) ================= -->
    <link name="rotor_1">
      <pose>0 0 -0.1 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="motor">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      <material><diffuse>0 1 0 1</diffuse></material>
      </visual>

      <visual name="prop_1">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.02 0.01</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 0.7 0.7 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ================= ROTOR 2 – PRZÓD (NIEBIESKI) ================= -->
    <link name="rotor_2">
      <pose>0.35 0 0 0 1.5708 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>

      <visual name="motor">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0 0 1 1</diffuse></material>
      </visual>

      <visual name="prop">
        <pose>-0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.35 0.01 0.005</size></box></geometry>
        <material><diffuse>0.7 0.7 1 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>1 0 0</xyz></axis>
    </joint>

    <!-- ================= ROTOR 3 – PRAWO (ŻÓŁTY) ================= -->
    <link name="rotor_3">
      <pose>0 -0.35 0 1.5708 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>

      <visual name="motor">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>1 1 0 1</diffuse></material>
      </visual>

      <visual name="prop">
        <pose>0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.35 0.01 0.005</size></box></geometry>
        <material><diffuse>1 1 0.7 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 -1 0</xyz></axis>
    </joint>

    <!-- ================= ROTOR 4 – TYŁ (MAGENTA) ================= -->
    <link name="rotor_4">
      <pose>-0.35 0 0 0 1.5708 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>

      <visual name="motor">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>1 0 1 1</diffuse></material>
      </visual>

      <visual name="prop">
        <pose>0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.35 0.01 0.005</size></box></geometry>
        <material><diffuse>1 0.7 1 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_4_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_4</child>
      <axis><xyz>-1 0 0</xyz></axis>
    </joint>

    <!-- ================= ROTOR 5 – LEWO (CYAN) ================= -->
    <link name="rotor_5">
      <pose>0 0.35 0 1.5708 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>1e-4</izz>
        </inertia>
      </inertial>

      <collision name="c">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
      </collision>

      <visual name="motor">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0 1 1 1</diffuse></material>
      </visual>

      <visual name="prop">
        <pose>-0.05 0 0 0 0 0</pose>
        <geometry><box><size>0.35 0.01 0.005</size></box></geometry>
        <material><diffuse>0.7 1 1 1</diffuse></material>
      </visual>
    </link>

    <joint name="rotor_5_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_5</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- ================= PLUGINS – GENERUJĄ SIŁĘ ================= -->
    <!-- (DOKŁADNIE JAK WCZEŚNIEJ, NIE ZMIENIAJ) -->

    <!-- motor 0 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

    <!-- motor 1 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

    <!-- motor 2 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

    <!-- motor 3 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

    <!-- motor 4 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_4_joint</jointName>
      <linkName>rotor_4</linkName>
      <turningDirection>cw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

    <!-- motor 5 -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_5_joint</jointName>
      <linkName>rotor_5</linkName>
      <turningDirection>cw</turningDirection>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>5</motorNumber>
      <motorType>velocity</motorType>
    </plugin>

  </model>
</sdf>
